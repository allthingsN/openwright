{
  "$defs": {
    "Citation": {
      "additionalProperties": true,
      "properties": {
        "instrument": {
          "title": "Instrument",
          "type": "string"
        },
        "article": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Article"
        },
        "clause": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clause"
        },
        "paragraphs": {
          "items": {
            "type": "string"
          },
          "title": "Paragraphs",
          "type": "array"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "effective_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Date"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "instrument"
      ],
      "title": "Citation",
      "type": "object"
    },
    "Condition": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "title": "Type",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "op": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Op"
        },
        "value": {
          "default": null,
          "title": "Value"
        },
        "link": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Link"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/EventFilter"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "conditions": {
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "title": "Conditions",
          "type": "array"
        }
      },
      "required": [
        "type"
      ],
      "title": "Condition",
      "type": "object"
    },
    "Control": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "requirement": {
          "title": "Requirement",
          "type": "string"
        },
        "citation": {
          "$ref": "#/$defs/Citation"
        },
        "scope": {
          "$ref": "#/$defs/EventFilter"
        },
        "condition": {
          "$ref": "#/$defs/Condition"
        },
        "empty_scope": {
          "$ref": "#/$defs/EmptyScopePolicy",
          "default": "insufficient_evidence"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "completeness_sensitive": {
          "default": false,
          "title": "Completeness Sensitive",
          "type": "boolean"
        },
        "variant": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variant"
        },
        "applies_to_profiles": {
          "items": {
            "type": "string"
          },
          "title": "Applies To Profiles",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "requirement",
        "citation",
        "condition"
      ],
      "title": "Control",
      "type": "object"
    },
    "EmptyScopePolicy": {
      "description": "What to report when no events fall in a control's scope.",
      "enum": [
        "insufficient_evidence",
        "satisfied",
        "not_satisfied"
      ],
      "title": "EmptyScopePolicy",
      "type": "string"
    },
    "EventFilter": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kind"
        },
        "risk_classification": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Risk Classification"
        },
        "oversight_status": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Oversight Status"
        },
        "source_format": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Format"
        },
        "attribute_equals": {
          "additionalProperties": true,
          "title": "Attribute Equals",
          "type": "object"
        },
        "has": {
          "items": {
            "type": "string"
          },
          "title": "Has",
          "type": "array"
        }
      },
      "title": "EventFilter",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    },
    "source": {
      "title": "Source",
      "type": "string"
    },
    "reviewed_as_of": {
      "title": "Reviewed As Of",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "disclaimer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Disclaimer"
    },
    "default_profiles": {
      "items": {
        "type": "string"
      },
      "title": "Default Profiles",
      "type": "array"
    },
    "controls": {
      "items": {
        "$ref": "#/$defs/Control"
      },
      "title": "Controls",
      "type": "array"
    }
  },
  "required": [
    "id",
    "title",
    "version",
    "source",
    "reviewed_as_of",
    "controls"
  ],
  "title": "OpenWright Crosswalk",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openwright.dev/crosswalk/1.0.0"
}
